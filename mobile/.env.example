# Copy to mobile/.env. The app only knows the backend URL: no Supabase keys here, ever.
# Deployed backend (Render):
EXPO_PUBLIC_API_URL=https://ea-fc-api.onrender.com
# Local backend instead: use your PC's LAN IP (not localhost) so the physical phone can reach it, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
